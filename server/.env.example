# ---------- Runtime ----------
# development | production | test
NODE_ENV=development
# Local API port. Render injects PORT automatically in production.
PORT=5001
# Reverse-proxy hops in front of Express (used for the real client IP in rate limiting).
# 0 locally. Render = 1. Vercel rewrite + Render = 2 (confirm after deploying).
TRUST_PROXY=0

# ---------- Database (MongoDB Atlas M0 or a local MongoDB) ----------
# Include a database name, e.g. mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/learn_loop?retryWrites=true&w=majority
MONGODB_URI=

# ---------- Auth ----------
# Random string, at least 32 characters.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Token lifetime: a number followed by s, m, h or d (for example 7d).
JWT_EXPIRES_IN=7d
# bcrypt cost factor (10-12). Higher is slower, and Render Free has very little CPU.
BCRYPT_SALT_ROUNDS=10
# lax (default; works with the Vercel /api rewrite), strict, or none (cross-site; HTTPS production only).
COOKIE_SAME_SITE=lax

# ---------- CORS / CSRF ----------
# Browser origin(s) allowed to call the API, comma-separated. No path, no trailing slash.
# Development: http://localhost:5173 | Production: your Vercel URL
ALLOWED_ORIGIN=http://localhost:5173

# ---------- Admin account (used only by the seed script) ----------
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------- AI: Google Gemini (free tier) ----------
# Leave empty to disable the AI Lesson Summarizer (the endpoint will answer 503).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# low | medium | high. gemini-3.8-flash rejects "minimal".
GEMINI_THINKING_LEVEL=low